# WYX.SPACE API 配置示例（fx1 B-12）
#
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略，绝不提交。
# 这里只列变量名与默认值，不含任何真实密钥。

# ---- 运行形态 ----
PORT=8787
HOST=127.0.0.1
# 数据目录（JSON 持久化）；容器内建议改成 /data
API_DATA_DIR=server/data
# 允许的前端来源，逗号分隔；生产改成 https://wyx.space
# 开发端口是 5273（vite.config.ts），不是 5173
API_CORS_ORIGIN=http://localhost:5273,http://127.0.0.1:5273,http://localhost:4173
# 部署在 Nginx / 网关后面时设 1，才会信任 X-Real-IP（否则只用 socket 地址）
TRUST_PROXY=0

# ---- 后台账号（首次启动写入 settings 旁边的用户库；生产必须改）----
# BE-01：未设置或使用 change-me / 少于 8 位时，服务会拒绝启动
ADMIN_USER=admin
ADMIN_PASS=change-me
EDITOR_USER=editor
EDITOR_PASS=change-me
# 会话有效期（毫秒），默认 7 天
SESSION_TTL_MS=604800000
# HTTPS 环境设为 1，Cookie 带 Secure
COOKIE_SECURE=0
# 埋点 IP 哈希盐，生产必须改
IP_SALT=change-me

# ---- AI 网关（OpenAI 兼容；留空则只做站内检索回答，不会假装调用模型）----
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=25000
AI_FIRST_TOKEN_MS=8000
AI_MAX_OUTPUT_TOKENS=700
AI_DAILY_QUOTA=60
AI_MONTHLY_TOKEN_BUDGET=3000000
AI_PRICE_PER_1K=0.002

# ---- 上传与存储 ----
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_EXT=pdf,md,zip,xlsx,fig,py,csv,pptx,docx,html,txt,png,jpg,webp,avif,svg
# local = 本机 server/data/uploads；接对象存储时再实现 s3 驱动（B-05）
STORAGE_DRIVER=local

# ---- 前端（Vite）----
# 本地开发推荐使用同源前缀 /api：Vite 会把 /api 代理到 VITE_API_PROXY_TARGET，
# HttpOnly Cookie 与页面同源，登录 / 会话最稳定（不要用 localhost 调 127.0.0.1 的跨站地址）。
# 生产环境由反向代理把 /api 指向服务端，保持同样的同源配置即可。
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
