{
  "name": "wyx-space",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run gen:seo && vite build && npm run prerender",
    "preview": "vite preview",
    "gen:seo": "node scripts/gen-seo.mjs",
    "prerender": "node scripts/prerender.mjs",
    "api": "node server/index.mjs",
    "gen:content": "node scripts/gen-content-snapshot.mjs",
    "eval:ai": "node scripts/eval-ai.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "check": "npm run check:data && npm run check:contrast && npm run check:budget",
    "verify": "npm run build && npm run check && node scripts/check-api.mjs && node scripts/eval-ai.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^11.11.17",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.462.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.183.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
